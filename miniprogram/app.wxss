page {
  background-color: #f9fafb;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

/* ── Layout ─────────────────────────────── */
.page-content { padding: 24rpx; }

/* ── Cards ──────────────────────────────── */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 20rpx;
}

/* ── Badges / Tags ───────────────────────── */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.tag-blue   { background: #eff6ff; color: #1d4ed8; }
.tag-green  { background: #f0fdf4; color: #15803d; }
.tag-orange { background: #fff7ed; color: #c2410c; }
.tag-purple { background: #f5f3ff; color: #6d28d9; }
.tag-gray   { background: #f3f4f6; color: #4b5563; }

/* ── Buttons ─────────────────────────────── */
.btn-primary {
  background: #f97316;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}
.btn-secondary {
  background: #ffffff;
  color: #374151;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 2rpx solid #e5e7eb;
}

/* ── Section titles ──────────────────────── */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

/* ── Stars ───────────────────────────────── */
.stars { color: #facc15; font-size: 24rpx; letter-spacing: 2rpx; }
.stars-empty { color: #e5e7eb; }

/* ── Empty state ─────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-state .empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-state .empty-text { font-size: 28rpx; color: #9ca3af; }

/* ── Loading ─────────────────────────────── */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}
