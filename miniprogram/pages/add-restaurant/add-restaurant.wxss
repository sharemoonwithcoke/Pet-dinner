.form-page { padding: 24rpx 24rpx 0; }
.form-group { margin-bottom: 28rpx; }
.form-row   { display: flex; gap: 16rpx; }
.half       { flex: 1; }

.label    { display: block; font-size: 26rpx; font-weight: 600; color: #374151; margin-bottom: 10rpx; }
.required { color: #ef4444; }

.input {
  background: #f9fafb; border: 2rpx solid #e5e7eb; border-radius: 14rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #111827;
  width: 100%; box-sizing: border-box;
}
.textarea {
  background: #f9fafb; border: 2rpx solid #e5e7eb; border-radius: 14rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #111827;
  width: 100%; min-height: 160rpx; box-sizing: border-box;
}
.ph { color: #9ca3af; }

.option-row  { display: flex; flex-wrap: wrap; gap: 12rpx; }
.option-chip {
  font-size: 26rpx; font-weight: 600; padding: 14rpx 28rpx;
  border-radius: 32rpx; border: 2rpx solid #e5e7eb;
  background: #f9fafb; color: #6b7280;
}
.option-chip.active { background: #fff7ed; border-color: #f97316; color: #f97316; }

.switch-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 2rpx solid #f9fafb;
}
.switch-label { font-size: 28rpx; color: #374151; }

.submit-btn {
  background: #f97316; color: #fff; font-size: 32rpx; font-weight: 800;
  border-radius: 20rpx; padding: 28rpx 0; text-align: center; margin-top: 16rpx;
}
.submit-btn.disabled { opacity: .6; }
