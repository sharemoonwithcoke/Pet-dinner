.page-content { padding: 24rpx; }

/* Stat grid */
.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.stat-card {
  flex: 1; min-width: 40%;
  background: #fff; border-radius: 20rpx; padding: 28rpx 16rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}
.stat-icon  { font-size: 48rpx; margin-bottom: 10rpx; }
.stat-value { font-size: 48rpx; font-weight: 800; margin-bottom: 6rpx; }
.stat-label { font-size: 22rpx; color: #9ca3af; }

/* Insights */
.insight-section { padding: 28rpx; margin-bottom: 20rpx; }
.insight-card    { display: flex; gap: 20rpx; align-items: flex-start; margin-bottom: 24rpx; }
.insight-card:last-child { margin-bottom: 0; }
.insight-icon    { font-size: 44rpx; flex-shrink: 0; }
.insight-body    { flex: 1; }
.insight-title   { display: block; font-size: 28rpx; font-weight: 700; color: #111827; margin-bottom: 8rpx; }
.insight-content { display: block; font-size: 24rpx; color: #374151; line-height: 1.7; }

/* Bar chart */
.chart-section { padding: 28rpx; margin-bottom: 20rpx; }
.bar-row   { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.bar-label { font-size: 24rpx; color: #374151; width: 80rpx; flex-shrink: 0; text-align: right; }
.bar-track { flex: 1; height: 16rpx; background: #f3f4f6; border-radius: 8rpx; overflow: hidden; }
.bar-fill  { height: 100%; background: #f97316; border-radius: 8rpx; transition: width .3s; }
.rating-fill { background: #facc15; }
.bar-value { font-size: 22rpx; color: #9ca3af; width: 120rpx; flex-shrink: 0; }

/* Cuisine column chart */
.cuisine-grid { display: flex; justify-content: space-around; align-items: flex-end; height: 200rpx; }
.cuisine-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; flex: 1; }
.cuisine-bar-wrap { flex: 1; width: 40rpx; display: flex; align-items: flex-end; }
.cuisine-bar  { width: 100%; border-radius: 6rpx 6rpx 0 0; min-height: 8rpx; }
.cuisine-value{ font-size: 22rpx; font-weight: 700; color: #374151; }
.cuisine-name { font-size: 18rpx; color: #9ca3af; text-align: center; }

/* Facility vertical bars */
.facility-grid { display: flex; justify-content: space-around; align-items: flex-end; height: 200rpx; }
.facility-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; flex: 1; }
.facility-pct  { font-size: 24rpx; font-weight: 800; color: #f97316; }
.facility-bar-bg { flex: 1; width: 32rpx; background: #f3f4f6; border-radius: 6rpx; overflow: hidden; display: flex; align-items: flex-end; }
.facility-bar-fill { width: 100%; background: #f97316; border-radius: 6rpx 6rpx 0 0; min-height: 4rpx; }
.facility-label{ font-size: 18rpx; color: #9ca3af; text-align: center; }

/* Leaderboard */
.rank-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f9fafb; }
.rank-row:last-child { border-bottom: none; }
.rank-badge { width: 56rpx; height: 56rpx; border-radius: 50%; background: #f3f4f6; color: #374151; font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rank-badge.gold   { background: #fef9c3; color: #854d0e; }
.rank-badge.silver { background: #f3f4f6; color: #4b5563; }
.rank-badge.bronze { background: #fff7ed; color: #c2410c; }
.rank-info  { flex: 1; }
.rank-name  { display: block; font-size: 28rpx; font-weight: 700; color: #111827; margin-bottom: 4rpx; }
.rank-sub   { display: block; font-size: 22rpx; color: #9ca3af; }
.rank-scores{ text-align: right; }
.rank-overall{ display: block; font-size: 26rpx; color: #f59e0b; font-weight: 700; }
.rank-pet   { display: block; font-size: 22rpx; color: #7c3aed; margin-top: 4rpx; }
