/* Hero */
.hero {
  background: linear-gradient(135deg, #f97316, #fb923c);
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
}
.hero-emoji  { font-size: 80rpx; margin-bottom: 16rpx; }
.hero-title  { font-size: 40rpx; font-weight: 800; color: #fff; margin-bottom: 8rpx; }
.hero-sub    { font-size: 26rpx; color: rgba(255,255,255,.85); margin-bottom: 28rpx; }
.hero-stats  { display: flex; justify-content: center; gap: 64rpx; }
.stat-item   { display: flex; flex-direction: column; align-items: center; }
.stat-value  { font-size: 40rpx; font-weight: 800; color: #fff; }
.stat-label  { font-size: 22rpx; color: rgba(255,255,255,.8); margin-top: 4rpx; }

/* Search */
.search-wrap { padding: 0 24rpx; margin-top: -36rpx; margin-bottom: 16rpx; }
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  gap: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.1);
}
.search-icon       { font-size: 32rpx; }
.search-input      { flex: 1; font-size: 28rpx; color: #111827; }
.search-placeholder{ color: #9ca3af; }
.clear-btn         { font-size: 28rpx; color: #9ca3af; padding: 0 8rpx; }

/* Filters */
.filter-section { background: #fff; padding: 16rpx 0 0; margin-bottom: 16rpx; }
.filter-row     { white-space: nowrap; padding: 0 24rpx 16rpx; }
.filter-chip {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #e5e7eb;
  background: #f9fafb;
  color: #6b7280;
  margin-right: 12rpx;
}
.filter-chip.active { background: #fff7ed; border-color: #f97316; color: #f97316; }

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 20rpx;
}
.count-text  { font-size: 24rpx; color: #9ca3af; }
.add-btn {
  background: #f97316;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

/* Restaurant card */
.restaurant-card { margin: 0 0 20rpx; }
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 28rpx 20rpx;
  background: linear-gradient(to right, #fff7ed, #fffbeb);
  border-bottom: 2rpx solid #fed7aa;
}
.card-header-left { flex: 1; margin-right: 16rpx; }
.restaurant-name  { font-size: 34rpx; font-weight: 800; color: #111827; margin-bottom: 8rpx; }
.restaurant-location { font-size: 24rpx; color: #9ca3af; }
.card-header-right { text-align: right; }
.price-label  { font-size: 36rpx; font-weight: 800; color: #f97316; }
.cuisine-label{ font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }

.ratings-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 32rpx;
}
.rating-block  { }
.rating-label  { font-size: 22rpx; color: #9ca3af; margin-bottom: 6rpx; }
.rating-stars  { display: flex; align-items: center; gap: 8rpx; }
.stars         { color: #facc15; font-size: 24rpx; }
.pet-stars     { color: #a78bfa; }
.rating-num    { font-size: 26rpx; font-weight: 700; color: #374151; }
.pet-num       { color: #7c3aed; }
.review-count  { margin-left: auto; font-size: 22rpx; color: #9ca3af; }

.tags-row { padding: 0 28rpx 24rpx; }
