.city-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 2rpx solid #f3f4f6;
  padding: 0 24rpx;
}
.city-scroll { flex: 1; white-space: nowrap; padding: 16rpx 0; }
.city-chip {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #6b7280;
  margin-right: 12rpx;
  border: 2rpx solid #e5e7eb;
}
.city-chip.active { background: #fff7ed; border-color: #f97316; color: #f97316; }
.count-badge { font-size: 24rpx; color: #9ca3af; margin-left: 12rpx; white-space: nowrap; }

.pet-map { width: 100%; height: 62vh; }

/* Bottom strip */
.bottom-strip { background: #fff; padding: 20rpx 0 12rpx; border-top: 2rpx solid #f3f4f6; }
.strip-title { font-size: 26rpx; font-weight: 700; color: #374151; padding: 0 24rpx 14rpx; }
.strip-scroll { white-space: nowrap; padding: 0 24rpx 12rpx; }
.mini-card {
  display: inline-block;
  width: 240rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-right: 16rpx;
  border: 2rpx solid #e5e7eb;
  vertical-align: top;
}
.mini-card.selected { background: #fff7ed; border-color: #f97316; }
.mini-name  { font-size: 26rpx; font-weight: 700; color: #111827; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mini-info  { font-size: 22rpx; color: #9ca3af; margin-bottom: 10rpx; }
.mini-footer{ display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.mini-price { font-size: 26rpx; font-weight: 800; color: #f97316; }
.mini-rating{ font-size: 22rpx; color: #6b7280; }
.mini-link  { font-size: 22rpx; color: #f97316; font-weight: 700; text-align: right; }

/* Callout overlay */
.callout-overlay {
  position: fixed;
  bottom: 0; left: 0; right: 0; top: 0;
  background: rgba(0,0,0,.35);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.callout-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 56rpx;
}
.callout-name     { font-size: 40rpx; font-weight: 800; color: #111827; margin-bottom: 10rpx; }
.callout-info     { font-size: 28rpx; color: #6b7280; margin-bottom: 6rpx; }
.callout-location { font-size: 26rpx; color: #9ca3af; margin-bottom: 6rpx; }
.callout-rating   { font-size: 28rpx; color: #f59e0b; margin-bottom: 32rpx; }
.callout-actions  { display: flex; gap: 20rpx; margin-top: 20rpx; }
.callout-btn      { flex: 1; text-align: center; padding: 24rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; }
.callout-btn.primary   { background: #f97316; color: #fff; }
.callout-btn.secondary { background: #f3f4f6; color: #374151; }
